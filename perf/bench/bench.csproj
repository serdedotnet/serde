<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <IsPackable>false</IsPackable>
    <Features Condition="'$(TargetFramework)'=='net11.0'">$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Newtonsoft.JSON" />
    <ProjectReference Include="../../src/serde/Serde.csproj" />
    <ProjectReference
      Include="../../src/generator/SerdeGenerator.csproj"
      OutputItemType="Analyzer"
    />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../test/Serde.Test/AllInOneSrc.cs" />
  </ItemGroup>
</Project>
